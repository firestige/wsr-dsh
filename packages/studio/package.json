{
  "name": "dsh-wsr-studio",
  "version": "0.0.0-development",
  "description": "Foundation-only DSH adapter bundle for WSR Studio. No BI/Evaluate owner feature is active in this development version.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.1.1-rc.2"
    }
  },
  "wsr": {
    "displayName": "WSR Studio",
    "role": "studio-adapter",
    "foundationOnly": true
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": "24.12.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firestige/wsr-dsh.git",
    "directory": "packages/studio"
  }
}
