{
  "name": "dsh-wsr-execution",
  "version": "0.2.5",
  "description": "DeepSeek Harness adapter bundle for WSR Intake, Delivery resources, Session state, Actions, and final results.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js",
    "skills",
    "cordis.patch.yml",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.1-rc.2"
    }
  },
  "wsr": {
    "displayName": "WSR",
    "role": "execution-adapter",
    "foundationOnly": false,
    "ownerRevision": "3c2f23e8a06b8a8dd5d61d4ed07637092323b93e",
    "ownerAsset": {
      "url": "https://github.com/firestige/wsr-execution/releases/download/0.2.4/wsr-execution-0.2.4.tgz",
      "sha256": "f38f3b3af21ace416418385b860aa70a89ce8388e9e5eef436eb706f63b6c6f1"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "wsr-execution": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": "24.12.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firestige/wsr-dsh.git",
    "directory": "packages/execution"
  }
}
