{
  "name": "dsh-wsr",
  "version": "0.2.7",
  "description": "Composition bundle for compatible WSR and WSR Studio DSH packages.",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.1.1-rc.2"
    }
  },
  "wsr": {
    "role": "compatible-composition",
    "foundationOnly": false
  },
  "dependencies": {
    "dsh-wsr-execution": "^0.2.7",
    "dsh-wsr-studio": "^0.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": "24.12.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firestige/wsr-dsh.git",
    "directory": "packages/suite"
  }
}
